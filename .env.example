# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET_KEY: Secret key for signing HS256 operator & bot session tokens.
JWT_SECRET_KEY="sonora-lucidadl-production-jwt-secret"

# TELEGRAM_BOT_TOKEN: Bot token from @BotFather for async polling worker.
TELEGRAM_BOT_TOKEN=""

# LUCIDADL_BIN: Path to lucidadl / lucida executable in Ubuntu PRoot or Docker.
LUCIDADL_BIN="/usr/local/bin/lucidadl"

# DOWNLOAD_DIR: Default validated output directory for audio files.
DOWNLOAD_DIR="/sdcard/Music"
